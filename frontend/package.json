{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:native": "npm run native:prepare && vue-tsc --noEmit && vite build --mode native",
    "preview": "vite preview",
    "native:prepare": "node scripts/prepare-native.mjs",
    "native:icon": "tauri icon public/app-icon.svg",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:win": "tauri build --target x86_64-pc-windows-msvc",
    "tauri:build:mac": "tauri build --target aarch64-apple-darwin",
    "tauri:build:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "cap:init": "cap add android",
    "cap:sync": "npm run build:native && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "harmony:pack": "node scripts/pack-harmonyos.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2",
    "@tauri-apps/cli": "^2.6.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vue-tsc": "^3.2.6"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/core": "^7.4.2",
    "@capacitor/ios": "^7.4.2",
    "@element-plus/icons-vue": "^2.3.2",
    "@omniagent/omni-sip": "file:native/plugins/omni-sip",
    "@tauri-apps/api": "^2.6.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "axios": "^1.14.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.13.6",
    "html2canvas": "^1.4.1",
    "jssip": "3.13.8",
    "pinia": "^3.0.4",
    "socket.io-client": "^4.8.3",
    "tesseract.js": "^6.0.1",
    "vue": "^3.5.31",
    "vue-router": "^5.0.4"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
