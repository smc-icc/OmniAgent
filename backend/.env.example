# ── Server ──
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ── Database (Chatwoot PostgreSQL) ──
DATABASE_URL="postgresql://postgres@localhost:5432/chatwoot_dev"

# ── Redis ──
REDIS_URL="redis://localhost:6379"

# ── JWT ──
JWT_SECRET="change-me-in-production-use-a-long-random-string"

# ── Storage (MinIO / S3) ──
# 未配置 S3_ACCESS_KEY 时自动使用本地目录 data/uploads（仅开发）
# Docker MinIO: cd OmniAgent/backend && docker compose up -d minio minio-init
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=omniagent-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# LOCAL_UPLOAD_DIR=./data/uploads

# ── Email ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# ── WeChat / WeCom webhooks (must be public HTTPS in production) ──
PUBLIC_BASE_URL=https://omni.seami.cloud
# ConfServer 同步渠道配置时使用的共享密钥（与 ConfServer PLATFORM_SYNC_SECRET 一致）
PLATFORM_SYNC_SECRET=change-me-sync-secret

# ── Omni channels ──
# Email IMAP 入站轮询间隔（毫秒）；设为 0 关闭后台轮询
EMAIL_INBOX_POLL_INTERVAL_MS=120000
# 可选：控制 ICC 菜单说明与 Meta/TikTok OAuth 文档
FACEBOOK_APP_ID=
TIKTOK_APP_ID=

# ── External APIs ──
OPENAI_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# ── Feature Flags ──
ENTERPRISE_MODE=false

# ── CCS Telephony (TARS) ──
CCS_AGENT_OBJ=SMC-ICC.CCSServer.AgentObj@tcp -h master.tars.com -p 9105
OMNI_AGENT_VDN_ID=1
OMNI_AGENT_SERVANT_OBJ=SMC-ICC.OmniAgent.AgentObj
OMNI_AGENT_SERVANT_HOST=0.0.0.0
OMNI_AGENT_SERVANT_PORT=9105
# IP/hostname CCSServer uses to call back On* (NOT 127.0.0.1 unless CCS runs on same host)
OMNI_AGENT_SERVANT_ADVERTISE_HOST=192.168.3.10
# users.uid is sent as CCS workNO; seed.ts sets demo uid=1001
CCS_WORK_NO_FIELD=uid
CCS_INVOKE_TIMEOUT_MS=30000
# 已废弃：最后一条 WS 断开立刻退队，此值忽略
CCS_WS_FLASH_MS=0
# 从 disconnect 起算 LoggedOff grace（默认 45s；空闲才注销，通话中延期到挂机）
CCS_WS_LOGOUT_GRACE_MS=45000
# 移动端（client=mobile）专用：切后台/锁屏会断 WS，注销 grace 要长得多
CCS_WS_LOGOUT_GRACE_MOBILE_MS=300000
# 移动端断开后继续留在 ACD 队列的时长，到期才签出技能组
CCS_WS_QUEUE_HOLD_MOBILE_MS=60000

# ── 移动坐席 SIP 接入（GET /api/agent/sip-credentials 的下发内容）──
# 对外 SBC；移动 App 只连 SBC，不直连内网 FreeSWITCH。留空则该接口返回 503
SIP_SBC_HOST=
SIP_SBC_PORT=5061
# tls | tcp | udp，生产强制 tls
SIP_SBC_TRANSPORT=tls
# SIP realm，须与 FreeSWITCH directory 的 domain 一致；留空则用 SIP_SBC_HOST
SIP_REALM=
# required | optional | disabled
SIP_SRTP=required
SIP_CODECS=opus,PCMA,PCMU
SIP_REGISTER_EXPIRES_S=300
SIP_STUN_SERVER=
SIP_ICE_ENABLED=0
SIP_CREDENTIALS_TTL_S=3600

# ── 旧环境变量推送回退；推荐在 ConfServer「系统帐号 → 推送帐号」统一管理 ──
# FCM HTTP v1 服务账号：JSON 文件路径或内联 JSON
PUSH_FCM_CREDENTIALS=
PUSH_FCM_PROJECT_ID=
# APNs token 认证：.p8 文件路径或内联 PEM
PUSH_APNS_KEY=
PUSH_APNS_KEY_ID=
PUSH_APNS_TEAM_ID=
PUSH_APNS_BUNDLE_ID=
PUSH_APNS_PRODUCTION=0
# 旧版鸿蒙环境变量兼容项；新鸿蒙接入使用 ConfServer 服务账号私钥 JSON
PUSH_HARMONY_CLIENT_ID=
PUSH_HARMONY_CLIENT_SECRET=

# ── ICC Integration Hub（默认关闭；1 开启）──
HUB_ENABLED=0
HUB_ROLE=inline
# 拆分进程：API 设 HUB_INGEST=0；Worker 设 HUB_ENABLED=1 HUB_ROLE=worker
# HUB_INGEST=1
# HUB_CONFIG_PATH=./src/integrations/hub/config/hub.example.yaml
# HUB_SINKS_DISABLED=
# ICC_LEAVEWORD_DIR=/var/icc/leaveword
# ICC_MYSQL_HOST=172.22.0.3
# ICC_MYSQL_PORT=3306
# ICC_MYSQL_USER=root
# ICC_MYSQL_PASSWORD=ChangeMe123!
# ICC_MYSQL_DB=icc

# ── ASR：默认 TARS ASRServer；FUNASR_ASR_URL 非空则改走其它 HTTP ASR ──
# ASR_OBJ=SMC-ICC.ASRServer.asrObj@tcp -h 172.22.0.4 -p 19399 -t 60000
# ASR_CLIP_DIR=/data/tars/omni-asr
# ASR_ENGINE=funasr
# FUNASR_ASR_URL=

# Enable only after singleton/tenancy migrations, explicit VDN-account binding and reconciliation.
# Never enable on an existing database without planning legacy identities/data ownership.
CONF_TENANCY_ENABLED=0

# 仅离线迁移/对账使用；必须另外停止真实写入，不是运行时维护开关。
CONF_TENANCY_MAINTENANCE=0

# Complete ICC migration and recovery-clone verification before enabling this flow.
OMNI_EXTENSION_BINDING_ENABLED=0
# FreeSWITCH ESL endpoint reachable by the backend; required for release/reassignment.
SIP_ESL_HOST=
SIP_ESL_PORT=8021
SIP_ESL_PASSWORD=
SIP_ESL_PROFILE=internal

# ConfServer-managed push credentials: shared 32-byte base64 AES-GCM key, preferably a private mounted file.
PUSH_CONFIG_ENCRYPTION_KEY_FILE=
# PUSH_CONFIG_ENCRYPTION_KEY=

# Community module authority (server-side only; configure before an existing ICC deployment switches).
SMC_DEPLOYMENT_ID=
SMC_MODULE_SERVICE_TOKEN=
SMC_MODULE_AUTHORITY_URL=
