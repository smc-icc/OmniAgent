{
  "name": "omniagent-backend",
  "version": "0.1.0",
  "description": "Chatwoot-compatible backend migrated from Ruby on Rails to Node.js (Fastify + TypeScript + Prisma)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node scripts/copy-runtime-assets.mjs",
    "start": "node dist/server.js",
    "hub:standalone": "tsx src/integrations/hub/standalone/main.ts",
    "hub:bench": "tsx src/integrations/hub/standalone/bench.ts",
    "hub:cutover-check": "tsx src/integrations/hub/standalone/cutover-check.ts",
    "hub:e2e": "tsx src/integrations/hub/standalone/e2e-check.ts",
    "test": "vitest run --config vitest.mobile.config.ts && vitest run --config vitest.hub.config.ts && vitest run --config vitest.pure.config.ts && vitest run --config vitest.access.config.ts && vitest run --config vitest.knowledge.config.ts && vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:introspect": "prisma db pull",
    "prisma:migrate": "prisma migrate dev",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "gen-tars": "powershell -ExecutionPolicy Bypass -File scripts/gen-tars.ps1",
    "test:release": "vitest run --config vitest.release.config.ts",
    "conf:reconcile": "node dist/tools/reconcile-conf-tenancy.js",
    "conf:migrate": "node dist/tools/migrate-conf-tenancy.js",
    "conf:ready": "node dist/tools/check-conf-tenancy.js",
    "test:extension": "vitest run --config vitest.extension.config.ts",
    "extension:preflight": "node scripts/migrate-extension-binding.mjs",
    "test:mobile": "vitest run --config vitest.mobile.config.ts",
    "test:mobile:integration": "vitest run --config vitest.mobile.integration.config.ts",
    "mobile:preflight": "node ../frontend/scripts/mobile-background-preflight.mjs --local-only",
    "mobile:migrate": "node scripts/migrate-mobile-calling.mjs",
    "test:mobile:local": "node scripts/test-mobile-local.mjs",
    "test:community": "vitest run --config vitest.community.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@fastify/cors": "^10.1.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.6",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/client": "^6.19.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tars/rpc": "2.0.14",
    "@tars/stream": "2.0.3",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.81.5",
    "dotenv": "^16.6.1",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0",
    "handlebars": "^4.7.9",
    "imapflow": "^1.7.8",
    "ioredis": "^5.11.1",
    "mailparser": "^3.9.33",
    "mysql2": "3.24.5",
    "nodemailer": "^10.0.13",
    "openai": "^6.49.0",
    "pino": "^9.14.0",
    "pino-pretty": "^11.3.0",
    "socket.io": "^4.8.4",
    "ssh2": "^1.17.0",
    "zod": "^3.25.76",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/ssh2": "^1.15.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "pnpm": {
    "overrides": {
      "@prisma/config@6.19.3>deepmerge-ts": "8.0.2"
    }
  }
}
