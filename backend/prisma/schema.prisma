model channel_wechat_mp {
  id                           Int      @id @default(autoincrement())
  account_id                   Int
  name                         String
  app_id                       String   @unique
  app_secret                   String
  token                        String
  encoding_aes_key             String?
  account_type                 String   @default("service")
  // 渠道能力：是否具备「客服消息」权限。
  // 认证服务号 / 认证订阅号 = true；未认证（含个人订阅号、未认证企业订阅号）= false。
  // 认证通过后只改这一项即可切回主动推送，不需要改代码或重新部署。
  supports_active_reply        Boolean  @default(true)
  // 无客服消息权限时启用「被动回复 + 积压队列」；supports_active_reply=false 时才有意义。
  passive_reply_enabled        Boolean  @default(false)
  // 被动回复菜单路由记录 TTL（秒）：发过 4 之后这段时间内的下一条消息按留言内容处理。
  route_ttl_seconds            Int      @default(300)
  // 待回复积压队列上限（条），超出丢弃最旧的。
  pending_reply_max            Int      @default(20)
  // 坐席回复超时（秒）：客户发言后的等待窗口内坐席没回出内容，就按「回复超时」处理
  // ——把会话收回给 ITR 走超时流程。0 = 不启用。
  // 「可主动推送」和「只能被动回复」两种渠道形态都有回复超时，区别只在挂哪个流程。
  reply_timeout_seconds        Int      @default(0)
  // 回复超时后要启动的 ITR 流程 id（0 = 不处理，维持现状）。
  reply_timeout_flow_id        Int      @default(0)
  // 第二级超时（秒）：等待这么久坐席仍未回，就把提示升级为「引导留言 / 按 9 转留言」。
  // 0 = 不启用二级。只对能主动推送的形态有效 —— 被动回复只有客户发言后的一个窗口，
  // 无法在 30 秒后主动联系客户（那条路径只能等客户下次发言带回）。
  reply_timeout_level2_seconds Int      @default(0)
  // 被动回复积压的存活时长（秒）：超过它的积压视为陈旧，取回时直接丢弃，
  // 不再回给客户（避免把几小时前的内容当作「旧账」送出去，客户会莫名其妙）。
  // 默认 300；0 = 不过期。
  pending_ttl_seconds          Int      @default(300)
  // 会话闲置回收（秒）：客户最后一次发言后这么久没有新消息，就把会话「回收」——
  // 清掉坐席归属与 ITR 流程状态，下一条消息重新走 on_inbound 的路由（菜单/机器人/排队）。
  //
  // 为什么要它：机器人把会话停在菜单上等输入，客户不发 1/4 就永远出不来；
  // 被动形态尤其明显（一次一问）。默认 300（5 分钟）；0 = 不回收。
  idle_recycle_seconds         Int      @default(300)
  created_at                   DateTime @default(now())
  updated_at                   DateTime @updatedAt

  @@index([account_id])
}

/// 一处候选路由：某渠道 + 某触发点 + 第 N 顺位 → 送往哪个目标。
///
/// 统一承接「进线 / ITR 决策 / ACD 结果 / 坐席超时 / 会话结束」各处的分发规则，
/// 不再把路由信息散落在渠道字段、会话属性和流程里。
/// 同一 (channel_id, trigger) 可配置多条，按 priority 升序依次尝试（失败降级）。
model channel_route {
  id              Int      @id @default(autoincrement())
  /// 渠道类型：wechat_mp | wecom_kf | wecom_contact | telegram | email | …（Conf 键）
  ///
  /// 必须带上它：不同渠道表的 id 各自从 1 开始（channel_wechat_mp.id=1 与
  /// channel_wecom_kf.id=1 同时存在），只用 channel_id 会互相串味。
  channel_type    String   @default("wechat_mp")
  /// 关联对应渠道表的 id（配合 channel_type 使用）
  channel_id      Int
  /// on_inbound | on_itr_route | on_acd_<结果码> | on_agent_no_answer
  /// | on_agent_no_reply | on_agent_end
  trigger         String
  /// 同一触发点多条时的尝试顺序（升序）
  priority        Int      @default(0)
  /// itr | agent | robot | acd | none
  app_type        String
  /// app_type=itr 时使用
  flow_id         Int      @default(0)
  /// app_type=agent 时使用
  agent_id        Int      @default(0)
  /// app_type=robot 时使用
  robot_id        Int      @default(0)
  /// app_type=acd 时使用
  agent_group_id  Int      @default(0)
  skill_id        Int      @default(0)
  media_type      Int      @default(0)
  line_priority   Int      @default(0)
  /// 可选覆盖：0 = 用渠道回复类型推导的默认时限
  ///（主动回复 300s；被动回复按渠道，微信订阅号 5s）
  timeout_seconds Int      @default(0)
  enabled         Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([channel_id, trigger, priority])
}

model channel_wecom_kf {
  id               Int      @id @default(autoincrement())
  account_id       Int
  name             String
  corp_id          String
  secret           String
  token            String
  encoding_aes_key String?
  open_kfid        String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([account_id])
  @@index([corp_id])
}

model channel_wecom_contact {
  id               Int      @id @default(autoincrement())
  account_id       Int
  name             String
  corp_id          String
  contact_secret   String
  token            String
  encoding_aes_key String?
  agent_id         Int?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([account_id])
  @@index([corp_id])
}

model channel_voice {
  id                    Int      @id @default(autoincrement())
  phone_number          String
  provider              String   @default("twilio")
  provider_config       Json
  account_id            Int
  additional_attributes Json     @default("{}")
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@unique([phone_number])
  @@index([account_id])
}

// ── Conversations & Messages ──

model conversations {
  id                     Int       @id @default(autoincrement())
  account_id             Int
  inbox_id               Int
  status                 Int       @default(0)
  assignee_id            Int?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt
  contact_id             Int?
  display_id             Int
  contact_last_seen_at   DateTime?
  agent_last_seen_at     DateTime?
  additional_attributes  Json      @default("{}")
  contact_inbox_id       Int?
  uuid                   String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier             String?
  last_activity_at       DateTime  @default(now())
  team_id                Int?
  campaign_id            Int?
  snoozed_until          DateTime?
  custom_attributes      Json      @default("{}")
  assignee_last_seen_at  DateTime?
  first_reply_created_at DateTime?
  priority               Int?
  sla_policy_id          Int?
  waiting_since          DateTime?
  cached_label_list      String?
  assignee_agent_bot_id  Int?

  account              accounts                    @relation(fields: [account_id], references: [id])
  inbox                inboxes                     @relation(fields: [inbox_id], references: [id])
  assignee             users?                      @relation("Assignee", fields: [assignee_id], references: [id])
  contact              contacts?                   @relation(fields: [contact_id], references: [id])
  contact_inbox        contact_inboxes?            @relation(fields: [contact_inbox_id], references: [id])
  team                 teams?                      @relation(fields: [team_id], references: [id])
  campaign             campaigns?                  @relation(fields: [campaign_id], references: [id])
  sla_policy           sla_policies?               @relation(fields: [sla_policy_id], references: [id])
  messages             messages[]
  participants         conversation_participants[]
  mentions             mentions[]
  csat_responses       csat_survey_responses[]
  applied_slas         applied_slas[]
  sla_events           sla_events[]
  reporting_events     reporting_events[]
  omni_session_records omni_session_records[]
  omni_session_events  omni_session_events[]

  @@unique([uuid])
  @@unique([account_id, display_id])
  @@index([account_id, inbox_id, status, assignee_id], map: "conv_acid_inbid_stat_asgnid_idx")
  @@index([account_id])
  @@index([assignee_id, account_id])
  @@index([campaign_id])
  @@index([contact_id])
  @@index([contact_inbox_id])
  @@index([first_reply_created_at])
  @@index([identifier, account_id])
  @@index([inbox_id])
  @@index([priority])
  @@index([status, account_id])
  @@index([status, priority])
  @@index([team_id])
  @@index([waiting_since])
}

model messages {
  id                        Int      @id @default(autoincrement())
  content                   String?
  account_id                Int
  inbox_id                  Int
  conversation_id           Int
  message_type              Int
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt
  private                   Boolean  @default(false)
  status                    Int      @default(0)
  source_id                 String?
  knowledge_trigger_id      Int?     @unique
  content_type              Int      @default(0)
  content_attributes        Json     @default("{}")
  sender_type               String?
  sender_id                 Int?
  external_source_ids       Json     @default("{}")
  additional_attributes     Json     @default("{}")
  processed_message_content String?
  sentiment                 Json     @default("{}")

  account              accounts               @relation(fields: [account_id], references: [id])
  inbox                inboxes                @relation(fields: [inbox_id], references: [id])
  conversation         conversations          @relation(fields: [conversation_id], references: [id])
  attachments          attachments[]
  csat_survey_response csat_survey_responses?

  @@index([account_id])
  @@index([account_id, inbox_id])
  @@index([conversation_id])
  @@index([inbox_id])
  @@index([source_id])
  @@index([created_at])
}

model conversation_participants {
  id              Int      @id @default(autoincrement())
  account_id      Int
  user_id         Int
  conversation_id Int
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  account      accounts      @relation(fields: [account_id], references: [id])
  user         users         @relation(fields: [user_id], references: [id])
  conversation conversations @relation(fields: [conversation_id], references: [id])

  @@unique([user_id, conversation_id])
  @@index([account_id])
  @@index([conversation_id])
  @@index([user_id])
}

model attachments {
  id               Int      @id @default(autoincrement())
  file_type        Int      @default(0)
  external_url     String?
  coordinates_lat  Float    @default(0.0)
  coordinates_long Float    @default(0.0)
  message_id       Int
  account_id       Int
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  fallback_title   String?
  extension        String?
  meta             Json     @default("{}")

  message messages @relation(fields: [message_id], references: [id])

  @@index([account_id])
  @@index([message_id])
}

// ── Contacts & Companies ──

model contacts {
  id                    Int       @id @default(autoincrement())
  name                  String    @default("")
  email                 String?
  phone_number          String?
  account_id            Int
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  additional_attributes Json      @default("{}")
  identifier            String?
  custom_attributes     Json      @default("{}")
  last_activity_at      DateTime?
  contact_type          Int       @default(0)
  middle_name           String    @default("")
  last_name             String    @default("")
  location              String    @default("")
  country_code          String    @default("")
  blocked               Boolean   @default(false)
  company_id            Int?

  account               accounts                @relation(fields: [account_id], references: [id])
  company               companies?              @relation(fields: [company_id], references: [id])
  contact_inboxes       contact_inboxes[]
  conversations         conversations[]
  csat_survey_responses csat_survey_responses[]
  notes                 notes[]
  contact_labels        contact_labels[]
  opportunities         opportunities[]

  @@unique([email, account_id], map: "uniq_email_per_account_contact")
  @@unique([identifier, account_id], map: "uniq_identifier_per_account_contact")
  @@index([account_id])
  @@index([account_id, contact_type])
  @@index([account_id, last_activity_at(sort: Desc)])
  @@index([blocked])
  @@index([company_id])
  @@index([phone_number, account_id])
}

model companies {
  id             Int      @id @default(autoincrement())
  name           String
  domain         String?
  description    String?
  account_id     Int
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  contacts_count Int?

  account       accounts        @relation(fields: [account_id], references: [id])
  contacts      contacts[]
  opportunities opportunities[]

  @@unique([account_id, domain], map: "index_companies_on_account_and_domain")
  @@index([account_id])
  @@index([name, account_id])
}

model contact_inboxes {
  id            Int      @id @default(autoincrement())
  contact_id    Int?
  inbox_id      Int?
  source_id     String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  hmac_verified Boolean  @default(false)
  pubsub_token  String?

  contact       contacts?       @relation(fields: [contact_id], references: [id])
  inbox         inboxes?        @relation(fields: [inbox_id], references: [id])
  conversations conversations[]

  @@unique([inbox_id, source_id])
  @@index([contact_id])
  @@index([inbox_id])
  @@index([pubsub_token])
  @@index([source_id])
}

// ── Teams, Labels, Notes ──

model teams {
  id                Int      @id @default(autoincrement())
  name              String
  description       String?
  allow_auto_assign Boolean  @default(true)
  account_id        Int
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  account       accounts        @relation(fields: [account_id], references: [id])
  team_members  team_members[]
  conversations conversations[]

  @@unique([name, account_id])
  @@index([account_id])
}

model team_members {
  id         Int      @id @default(autoincrement())
  team_id    Int
  user_id    Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  team teams @relation(fields: [team_id], references: [id])
  user users @relation(fields: [user_id], references: [id])

  @@unique([team_id, user_id])
  @@index([team_id])
  @@index([user_id])
}

model labels {
  id              Int      @id @default(autoincrement())
  title           String?
  description     String?
  color           String   @default("#1f93ff")
  show_on_sidebar Boolean?
  account_id      Int?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  account        accounts?        @relation(fields: [account_id], references: [id])
  contact_labels contact_labels[]

  @@unique([title, account_id])
  @@index([account_id])
}

/**
 * CRM：联系人 ↔ 标签
 */
model contact_labels {
  id         Int      @id @default(autoincrement())
  contact_id Int
  label_id   Int
  created_at DateTime @default(now())

  contact contacts @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  label   labels   @relation(fields: [label_id], references: [id], onDelete: Cascade)

  @@unique([contact_id, label_id])
  @@index([label_id])
  @@index([contact_id])
}

/**
 * CRM：商机
 */
model opportunities {
  id                Int       @id @default(autoincrement())
  account_id        Int
  contact_id        Int?
  company_id        Int?
  title             String
  stage             String    @default("new")
  amount            Float?
  currency          String    @default("CNY")
  owner_id          Int?
  expected_close    DateTime?
  status            String    @default("open")
  custom_attributes Json      @default("{}")
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  account accounts   @relation(fields: [account_id], references: [id])
  contact contacts?  @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  company companies? @relation(fields: [company_id], references: [id], onDelete: SetNull)
  owner   users?     @relation(fields: [owner_id], references: [id], onDelete: SetNull)

  @@index([account_id, stage])
  @@index([contact_id])
  @@index([company_id])
  @@index([owner_id])
}

model notes {
  id         Int      @id @default(autoincrement())
  content    String
  account_id Int
  contact_id Int
  user_id    Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  account accounts @relation(fields: [account_id], references: [id])
  contact contacts @relation(fields: [contact_id], references: [id])
  user    users?   @relation(fields: [user_id], references: [id])

  @@index([account_id])
  @@index([contact_id])
  @@index([user_id])
}

// ── Automation & Macros ──

model automation_rules {
  id          Int      @id @default(autoincrement())
  account_id  Int
  name        String
  description String?
  event_name  String
  conditions  Json     @default("{}")
  actions     Json     @default("{}")
