  @@index([campaign_status])
  @@index([campaign_type])
  @@index([inbox_id])
  @@index([scheduled_at])
}

// ── CSAT & SLA ──

model csat_survey_responses {
  id                         Int       @id @default(autoincrement())
  account_id                 Int
  conversation_id            Int
  message_id                 Int
  rating                     Int
  feedback_message           String?
  contact_id                 Int
  assigned_agent_id          Int?
  created_at                 DateTime  @default(now())
  updated_at                 DateTime  @updatedAt
  csat_review_notes          String?
  review_notes_updated_at    DateTime?
  review_notes_updated_by_id Int?

  account        accounts      @relation(fields: [account_id], references: [id])
  conversation   conversations @relation(fields: [conversation_id], references: [id])
  message        messages      @relation(fields: [message_id], references: [id])
  contact        contacts      @relation(fields: [contact_id], references: [id])
  assigned_agent users?        @relation("AssignedAgent", fields: [assigned_agent_id], references: [id])

  @@unique([message_id])
  @@index([account_id])
  @@index([assigned_agent_id])
  @@index([contact_id])
  @@index([conversation_id])
}

model sla_policies {
