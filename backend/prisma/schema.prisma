  @@unique([identifier])
  @@index([user_id])
}

// ── Campaigns ──

model campaigns {
  id                                 Int       @id @default(autoincrement())
  display_id                         Int
  title                              String
  description                        String?
  message                            String
  sender_id                          Int?
  enabled                            Boolean   @default(true)
  account_id                         Int
  inbox_id                           Int
