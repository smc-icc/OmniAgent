  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  @@index([vdn_id, occurred_at(sort: Desc)])
}

/**
 * Omni 全媒体会话单（对齐 CCS 话单，不写 ICC 话务表）
 */
model omni_session_records {
  id                Int       @id @default(autoincrement())
  conversation_id   Int
  account_id        Int       @default(0)
  inbox_id          Int       @default(0)
  contact_id        Int?
  channel           String    @default("media")
  visitor_name      String    @default("")
  visitor_id        String    @default("")
  queued_at         DateTime?
  assigned_at       DateTime?
  answered_at       DateTime?
  ended_at          DateTime?
  wait_sec          Int       @default(0)
  talk_sec          Int       @default(0)
  skill_id          Int       @default(0)
  skill_group_id    Int       @default(0)
  skill_group_name  String    @default("")
  vdn_id            Int       @default(0)
  acd_request_id    Int       @default(0)
  method            String    @default("inbound")
  release_cause     String    @default("")
  release_reason    String    @default("")
  assignee_user_id  Int?
  assignee_work_no  String    @default("")
  assignee_agent_id Int       @default(0)
  assignee_name     String    @default("")
  extra             Json      @default("{}")
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  conversation conversations         @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  events       omni_session_events[]

  @@index([conversation_id, created_at])
  @@index([contact_id, created_at])
  @@index([assignee_user_id, created_at])
  @@index([account_id, created_at])
  @@index([ended_at])
}

/**
 * Omni 坐席/系统对会话的操作流水
 */
model omni_session_events {
  id                Int      @id @default(autoincrement())
  conversation_id   Int
  session_record_id Int?
  account_id        Int      @default(0)
  event_type        String
  actor_user_id     Int?
  actor_work_no     String   @default("")
  actor_agent_id    Int      @default(0)
  actor_name        String   @default("")
  target_user_id    Int?
  target_work_no    String   @default("")
  target_agent_id   Int      @default(0)
  summary           String   @default("")
  payload           Json     @default("{}")
  created_at        DateTime @default(now())

  conversation   conversations         @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  session_record omni_session_records? @relation(fields: [session_record_id], references: [id], onDelete: SetNull)

  @@index([conversation_id, created_at])
  @@index([session_record_id, created_at])
  @@index([event_type, created_at])
  @@index([actor_user_id, created_at])
}

// Knowledge and RAGFlow metadata. External IDs are opaque strings and are
// intentionally kept separate from the provider's database schema.
model knowledge_connections {
  id                 String   @id @default(uuid())
  account_id         Int
  vdn_id             Int
  provider           String
  base_url           String
  credential_ref     String
  external_tenant_id String
  state              String   @default("active")
  contract_version   String
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  bindings knowledge_bindings[]

  @@unique([account_id, vdn_id, provider])
  @@index([account_id, vdn_id, state])
}

model knowledge_bases {
  id                String   @id @default(uuid())
  account_id        Int
  vdn_id            Int
  name              String
  owner_user_id     Int
  department_id     Int?
  agent_group_ids   Json     @default("[]")
  state             String   @default("active")
  acl_revision      Int      @default(0)
  active_generation Int      @default(1)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  bindings  knowledge_bindings[]
  documents knowledge_documents[]
  acl       knowledge_acl_entries[]

  @@index([account_id, vdn_id, state])
  @@index([owner_user_id])
}

model knowledge_bindings {
  id                  String   @id @default(uuid())
  base_id             String
  connection_id       String
  external_dataset_id String
  generation          Int
  parser_profile      Json     @default("{}")
  embedding_model     String
  config_hash         String
  state               String   @default("active")
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  base       knowledge_bases               @relation(fields: [base_id], references: [id], onDelete: Cascade)
  connection knowledge_connections         @relation(fields: [connection_id], references: [id], onDelete: Restrict)
  versions   knowledge_document_versions[]

  @@unique([connection_id, external_dataset_id])
  @@unique([base_id, generation])
  @@index([base_id, state])
}

model knowledge_documents {
  id                String    @id @default(uuid())
  account_id        Int
  vdn_id            Int
  base_id           String
  source_type       String
  source_id         String
  title             String
  category          String
  tags              Json      @default("[]")
  owner_user_id     Int
  acl_mode          String    @default("inherit")
  state             String    @default("draft")
  active_version_id String?
  audience          String    @default("internal")
  valid_from        DateTime?
  valid_to          DateTime?
  deleted_at        DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  base     knowledge_bases               @relation(fields: [base_id], references: [id], onDelete: Cascade)
  versions knowledge_document_versions[]
  acl      knowledge_acl_entries[]

  @@unique([account_id, vdn_id, source_type, source_id])
  @@index([account_id, vdn_id, state, audience, valid_to])
  @@index([base_id, state])
}

model knowledge_document_versions {
  id                   String    @id @default(uuid())
  document_id          String
  version_no           Int
  binding_id           String
  external_document_id String?
  content_sha256       String
  object_key           String?
  inline_content       String?
  parser_config_hash   String
  index_state          String    @default("pending")
  review_state         String    @default("draft")
  chunk_count          Int       @default(0)
  error_code           String?
  created_by           Int
  reviewed_by          Int?
  reviewed_at          DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  document knowledge_documents @relation(fields: [document_id], references: [id], onDelete: Cascade)
  binding  knowledge_bindings  @relation(fields: [binding_id], references: [id], onDelete: Restrict)

  @@unique([document_id, version_no])
  @@unique([binding_id, external_document_id])
  @@index([document_id, index_state, review_state])
}

model knowledge_acl_entries {
  id           String   @id @default(uuid())
  account_id   Int
  vdn_id       Int
  base_id      String
  document_id  String?
  capability   String
  subject_type String
  subject_id   String
  created_at   DateTime @default(now())

  base     knowledge_bases      @relation(fields: [base_id], references: [id], onDelete: Cascade)
  document knowledge_documents? @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@unique([account_id, vdn_id, base_id, document_id, capability, subject_type, subject_id])
  @@index([account_id, vdn_id, capability, subject_type, subject_id])
}

model knowledge_sync_jobs {
  id                   String    @id @default(uuid())
  account_id           Int
  vdn_id               Int
  operation            String
  document_id          String?
  version_id           String?
  binding_id           String?
  dedupe_key           String
  state                String    @default("queued")
  attempts             Int       @default(0)
  next_run_at          DateTime  @default(now())
  locked_until         DateTime?
  external_request_key String?
  actor_user_id        Int?
  actor_kind           String    @default("user")
  payload              Json      @default("{}")
  result_object_key    String?
  last_error           String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  @@unique([account_id, vdn_id, dedupe_key])
  @@index([state, next_run_at])
  @@index([account_id, vdn_id, document_id])
}

model knowledge_audit_events {
  id                String   @id @default(uuid())
  account_id        Int
  vdn_id            Int
  actor_kind        String
  actor_id          String?
  action            String
  resource_id       String
  previous_revision Int?
  next_revision     Int?
  request_id        String
  outcome           String
  created_at        DateTime @default(now())

  @@index([account_id, vdn_id, resource_id, created_at])
  @@index([request_id])
}

// ConfManager owns these identity projections; WorkNO/email are not global keys.
model conf_vdn_accounts {
  vdn_id     Int      @id
  account_id Int      @unique
  enabled    Boolean  @default(true)
  updated_at DateTime @updatedAt
}

model conf_user_bindings {
  id             Int      @id @default(autoincrement())
  vdn_id         Int
  source_user_id Int
  user_id        Int      @unique
  work_no        String
  enabled        Boolean  @default(true)
  updated_at     DateTime @updatedAt

  @@unique([vdn_id, source_user_id])
  @@unique([vdn_id, work_no])
}

model social_organizations {
  id            String                            @id @default(uuid())
  code          String                            @unique @db.VarChar(64)
  account_id    Int                               @unique
  vdn_id        Int                               @unique
  enabled       Boolean                           @default(false)
  created_at    DateTime                          @default(now())
  updated_at    DateTime                          @updatedAt
  account       accounts                          @relation(fields: [account_id], references: [id], onDelete: Restrict)
  installations social_enterprise_installations[]
  identities    social_user_identities[]
}

model social_provider_apps {
  id                    String                            @id @default(uuid())
  provider              String                            @db.VarChar(24)
  client_id             String                            @db.VarChar(256)
  enabled               Boolean                           @default(false)
  approved_platforms    Json                              @default("[]")
  verified_platforms    Json                              @default("[]")
  native_metadata       Json                              @default("{}")
  encrypted_credentials String
  credential_key_id     String                            @db.VarChar(40)
  created_at            DateTime                          @default(now())
  updated_at            DateTime                          @updatedAt
  installations         social_enterprise_installations[]
  identities            social_user_identities[]

  @@unique([provider, client_id])
}

model social_enterprise_installations {
  id                       String               @id @default(uuid())
  app_id                   String
  organization_id          String
  provider                 String               @db.VarChar(24)
  external_organization_id String               @db.VarChar(256)
  status                   String               @default("pending") @db.VarChar(24)
  encrypted_credentials    String?
  credential_key_id        String?              @db.VarChar(40)
  expires_at               DateTime?
  revoked_at               DateTime?
  authorization_revision   Int                  @default(1)
  created_at               DateTime             @default(now())
  updated_at               DateTime             @updatedAt
  app                      social_provider_apps @relation(fields: [app_id], references: [id], onDelete: Restrict)
  organization             social_organizations @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@unique([app_id, organization_id])
  @@index([app_id, external_organization_id], map: "social_installation_app_external_org_idx")
}

model social_user_identities {
  id                       String               @id @default(uuid())
  app_id                   String
  organization_id          String
  external_organization_id String               @db.VarChar(256)
  subject_id               String               @db.VarChar(256)
  user_id                  Int
  enabled                  Boolean              @default(true)
  created_at               DateTime             @default(now())
  updated_at               DateTime             @updatedAt
  app                      social_provider_apps @relation(fields: [app_id], references: [id], onDelete: Restrict)
  organization             social_organizations @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user                     users                @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([app_id, external_organization_id, subject_id])
  @@index([organization_id, user_id])
}

model social_authorization_events {
  id                String    @id @default(uuid())
  provider          String    @db.VarChar(24)
  app_id            String
  organization_id   String?
  external_event_id String    @db.VarChar(256)
  event_type        String    @db.VarChar(64)
  payload_digest    String    @db.VarChar(64)
  received_at       DateTime  @default(now())
  processed_at      DateTime?

  @@unique([provider, app_id, external_event_id])
}
