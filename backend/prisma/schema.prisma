  account accounts @relation(fields: [account_id], references: [id])

  @@index([account_id])
}

model macros {
  id            Int      @id @default(autoincrement())
  account_id    Int
  name          String
  visibility    Int      @default(0)
  created_by_id Int?
  updated_by_id Int?
  actions       Json     @default("{}")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  account    accounts @relation(fields: [account_id], references: [id])
  created_by users?   @relation("CreatedBy", fields: [created_by_id], references: [id])
  updated_by users?   @relation("UpdatedBy", fields: [updated_by_id], references: [id])

  @@index([account_id])
}

model canned_responses {
  id         Int      @id @default(autoincrement())
  account_id Int
  short_code String?
  content    String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

/**
 * 短信模板：班长（administrator）维护，坐席只能选用 approved 模板并填变量。
 * 合规要点：正文与签名受控（对应运营商报备的完整模板），坐席不可自由改写；
 * provider_template_id 为运营商报备返回的模板 ID，接入阿里云/腾讯云等正式网关时必填。
 */
model sms_templates {
  id                   Int      @id @default(autoincrement())
  account_id           Int
  name                 String   @db.VarChar(120)
  category             String   @default("notice") @db.VarChar(40)
  signature            String   @default("") @db.VarChar(40)
  body                 String   @db.Text
  variables            Json     @default("[]")
  provider             String?  @db.VarChar(40)
  provider_template_id String?  @db.VarChar(120)
  status               String   @default("draft") @db.VarChar(20)
  created_by           Int?
  updated_by           Int?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@index([account_id, status])
  @@index([account_id, name])
}

// ── Notifications ──

model notifications {
  id                   Int       @id @default(autoincrement())
  account_id           Int
  user_id              Int
  notification_type    Int
  primary_actor_type   String
  primary_actor_id     Int
  secondary_actor_type String?
