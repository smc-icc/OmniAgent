  account_id                    Int
  created_at                    DateTime @default(now())
  updated_at                    DateTime @updatedAt
  description                   String?
  resolution_time_threshold     Float?

  account       accounts        @relation(fields: [account_id], references: [id])
  applied_slas  applied_slas[]
  sla_events    sla_events[]
  conversations conversations[]

  @@index([account_id])
}

model applied_slas {
  id              Int      @id @default(autoincrement())
  account_id      Int
  sla_policy_id   Int
  conversation_id Int
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  sla_status      Int      @default(0)

  account      accounts      @relation(fields: [account_id], references: [id])
  sla_policy   sla_policies  @relation(fields: [sla_policy_id], references: [id])
  conversation conversations @relation(fields: [conversation_id], references: [id])
  sla_events   sla_events[]

  @@unique([account_id, sla_policy_id, conversation_id], map: "index_applied_slas_on_account_sla_policy_conversation")
  @@index([account_id])
  @@index([conversation_id])
  @@index([sla_policy_id])
}

model sla_events {
  id              Int      @id @default(autoincrement())
  applied_sla_id  Int
  conversation_id Int
  account_id      Int
  sla_policy_id   Int
  inbox_id        Int
  event_type      Int?
  meta            Json     @default("{}")
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  applied_sla  applied_slas  @relation(fields: [applied_sla_id], references: [id])
  conversation conversations @relation(fields: [conversation_id], references: [id])
  account      accounts      @relation(fields: [account_id], references: [id])
  sla_policy   sla_policies  @relation(fields: [sla_policy_id], references: [id])
  inbox        inboxes       @relation(fields: [inbox_id], references: [id])

  @@index([account_id])
  @@index([applied_sla_id])
  @@index([conversation_id])
  @@index([inbox_id])
  @@index([sla_policy_id])
}

