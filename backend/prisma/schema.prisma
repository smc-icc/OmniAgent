/// VDN 营业时间 —— IVR 检测工作时间的数据源（flow 里的 CheckWorkTime 节点读它）。
///
/// 与 inbox 级 working_hours 解耦：working_hours 决定 omni 客服界面的在线/离线，
/// 本表决定 IVR 呼入走"营业中"（Next）还是"非营业"（OutTime）分支。
///
/// day_of_week: 0=周日 1=周一 ... 6=周六（与 working_hours 一致，前端可复用同一套 UI）
/// 判定时区固定 Asia/Shanghai（PG 容器是 UTC，IVR 侧自行换算，不用 PG 的 now()）
model conf_vdn_working_hours {
  id             Int      @id @default(autoincrement())
  vdn_id         Int
  day_of_week    Int
  closed_all_day Boolean  @default(false)
  open_all_day   Boolean  @default(false)
  open_hour      Int      @default(9)
  open_minutes   Int      @default(0)
  close_hour     Int      @default(18)
  close_minutes  Int      @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@unique([vdn_id, day_of_week], name: "conf_vdn_working_hours_uniq")
  @@index([vdn_id])
}

