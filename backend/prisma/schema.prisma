generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_stat_statements, pg_trgm, pgcrypto, plpgsql, vector]
}

// ── Core: Users, Accounts, Auth ──

model users {
  id                     Int                      @id @default(autoincrement())
  provider               String                   @default("email")
  uid                    String                   @default("")
  encrypted_password     String                   @default("")
  reset_password_token   String?
  reset_password_sent_at DateTime?
  remember_created_at    DateTime?
  sign_in_count          Int                      @default(0)
  current_sign_in_at     DateTime?
  last_sign_in_at        DateTime?
  current_sign_in_ip     String?
  last_sign_in_ip        String?
  confirmation_token     String?
  confirmed_at           DateTime?
  confirmation_sent_at   DateTime?
  unconfirmed_email      String?
  name                   String
  display_name           String?
  email                  String?
  tokens                 Json?
  created_at             DateTime                 @default(now())
  updated_at             DateTime                 @updatedAt
  pubsub_token           String?                  @unique
  availability           Int                      @default(0)
  ui_settings            Json                     @default("{}")
  social_identities      social_user_identities[]
  custom_attributes      Json                     @default("{}")
  type                   String?
  message_signature      String?
  otp_secret             String?                  @unique
  consumed_timestep      Int?
  otp_required_for_login Boolean                  @default(false)
  otp_backup_codes       String?

  account_users              account_users[]
  notification_subscriptions notification_subscriptions[]
  notifications              notifications[]
  mentions                   mentions[]
  copilot_threads            copilot_threads[]
  custom_filters             custom_filters[]
  dashboard_apps             dashboard_apps[]
  team_members               team_members[]
  notes                      notes[]
  macros                     macros[]                     @relation("CreatedBy")
  macros_updated             macros[]                     @relation("UpdatedBy")
  conversations              conversations[]              @relation("Assignee")
  csat_survey_responses      csat_survey_responses[]      @relation("AssignedAgent")
  leaves                     leaves[]
  leaves_approved            leaves[]                     @relation("ApprovedBy")
  conversation_participants  conversation_participants[]
  inbox_members              inbox_members[]
  agent_memos                agent_memos[]
  agent_calendar_events      agent_calendar_events[]
  agent_shift_boards         agent_shift_boards[]
  opportunities              opportunities[]
  rest_requests_as_applicant agent_rest_requests[]        @relation("RestApplicant")
  rest_requests_as_leader    agent_rest_requests[]        @relation("RestLeader")

  @@index([email])
  @@index([uid, provider], map: "index_users_on_uid_and_provider")
  @@index([otp_required_for_login])
}

model accounts {
  id                    Int                    @id @default(autoincrement())
  name                  String
  social_organizations  social_organizations[]
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt
  locale                Int                    @default(0)
  domain                String?                @db.VarChar(100)
  support_email         String?                @db.VarChar(100)
  feature_flags         BigInt                 @default(0)
  auto_resolve_duration Int?
  limits                Json                   @default("{}")
  custom_attributes     Json                   @default("{}")
  status                Int                    @default(0)
  internal_attributes   Json                   @default("{}")
  settings              Json                   @default("{}")

  account_users               account_users[]
  agent_bots                  agent_bots[]
  saml_settings               account_saml_settings[]
  automation_rules            automation_rules[]
  campaigns                   campaigns[]
  contacts                    contacts[]
  companies                   companies[]
  conversations               conversations[]
  custom_attribute_defs       custom_attribute_definitions[]
  custom_filters              custom_filters[]
  custom_roles                custom_roles[]
  csat_survey_responses       csat_survey_responses[]
  dashboard_apps              dashboard_apps[]
  data_imports                data_imports[]
  inboxes                     inboxes[]
  labels                      labels[]
  macros                      macros[]
  mentions                    mentions[]
  messages                    messages[]
  notes                       notes[]
  notifications               notifications[]
  portals                     portals[]
  opportunities               opportunities[]
  reporting_events            reporting_events[]
  reporting_events_rollups    reporting_events_rollups[]
  sla_policies                sla_policies[]
  applied_slas                applied_slas[]
  sla_events                  sla_events[]
  conversation_participants   conversation_participants[]
  teams                       teams[]
  webhooks                    webhooks[]
  working_hours               working_hours[]
  email_templates             email_templates[]
  agent_capacity_policies     agent_capacity_policies[]
  assignment_policies         assignment_policies[]
  captain_assistants          captain_assistants[]
  captain_assistant_responses captain_assistant_responses[]
  captain_documents           captain_documents[]
  captain_custom_tools        captain_custom_tools[]
  captain_scenarios           captain_scenarios[]
  copilot_threads             copilot_threads[]
  copilot_messages            copilot_messages[]
  articles                    articles[]
  categories                  categories[]
  leaves                      leaves[]

  @@index([status])
}

model account_users {
  id                       Int       @id @default(autoincrement())
  account_id               Int?
  user_id                  Int?
  role                     Int       @default(0)
  inviter_id               Int?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt
  active_at                DateTime?
  availability             Int       @default(0)
  auto_offline             Boolean   @default(true)
  custom_role_id           Int?
  agent_capacity_policy_id Int?

  account               accounts?                @relation(fields: [account_id], references: [id])
  user                  users?                   @relation(fields: [user_id], references: [id])
  custom_role           custom_roles?            @relation(fields: [custom_role_id], references: [id])
  agent_capacity_policy agent_capacity_policies? @relation(fields: [agent_capacity_policy_id], references: [id])

  @@unique([account_id, user_id], map: "uniq_user_id_per_account_id")
  @@index([account_id])
  @@index([user_id])
  @@index([custom_role_id])
  @@index([agent_capacity_policy_id])
}

model access_tokens {
  id         Int      @id @default(autoincrement())
  owner_type String
  owner_id   BigInt
  token      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([token])
  @@index([owner_type, owner_id])
}

model account_saml_settings {
  id            Int      @id @default(autoincrement())
  account_id    Int
  sso_url       String?
  certificate   String?
  sp_entity_id  String?
  idp_entity_id String?
  role_mappings Json     @default("{}")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  account accounts @relation(fields: [account_id], references: [id])

  @@index([account_id])
}

// ── Inboxes & Channels ──

model inboxes {
  id                            Int      @id @default(autoincrement())
  channel_id                    Int
  account_id                    Int
  name                          String
  created_at                    DateTime @default(now())
  updated_at                    DateTime @updatedAt
  channel_type                  String?
  enable_auto_assignment        Boolean  @default(true)
  greeting_enabled              Boolean  @default(false)
  greeting_message              String?
  email_address                 String?
  working_hours_enabled         Boolean  @default(false)
  out_of_office_message         String?
  timezone                      String   @default("UTC")
  enable_email_collect          Boolean  @default(true)
  csat_survey_enabled           Boolean  @default(false)
  allow_messages_after_resolved Boolean  @default(true)
  auto_assignment_config        Json     @default("{}")
  lock_to_single_conversation   Boolean  @default(false)
  portal_id                     Int?
  sender_name_type              Int      @default(0)
  business_name                 String?
  csat_config                   Json     @default("{}")

  account                   accounts                    @relation(fields: [account_id], references: [id])
  portal                    portals?                    @relation(fields: [portal_id], references: [id])
  agent_bot_inboxes         agent_bot_inboxes[]
  campaigns                 campaigns[]
  contact_inboxes           contact_inboxes[]
  conversations             conversations[]
  inbox_members             inbox_members[]
  messages                  messages[]
  webhooks                  webhooks[]
  working_hours             working_hours[]
  captain_inboxes           captain_inboxes[]
  inbox_assignment_policies inbox_assignment_policies[]
  inbox_capacity_limits     inbox_capacity_limits[]
  reporting_events          reporting_events[]
  sla_events                sla_events[]
  integrations_hooks        integrations_hooks[]

  @@index([account_id])
  @@index([channel_id, channel_type])
}

model inbox_members {
  id         Int      @id @default(autoincrement())
  user_id    Int
  inbox_id   Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  inbox inboxes @relation(fields: [inbox_id], references: [id])
  user  users   @relation(fields: [user_id], references: [id])

  @@unique([inbox_id, user_id])
  @@index([inbox_id])
}

model agent_bot_inboxes {
  id           Int      @id @default(autoincrement())
  inbox_id     Int?
  agent_bot_id Int?
  status       Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  account_id   Int?

  inbox     inboxes?    @relation(fields: [inbox_id], references: [id])
  agent_bot agent_bots? @relation(fields: [agent_bot_id], references: [id])
}

model agent_bots {
  id           Int      @id @default(autoincrement())
  name         String?
  description  String?
  outgoing_url String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  account_id   Int?
  bot_type     Int      @default(0)
  bot_config   Json     @default("{}")

  account           accounts?           @relation(fields: [account_id], references: [id])
  agent_bot_inboxes agent_bot_inboxes[]

  @@index([account_id])
}

model channel_api {
  id                    Int      @id @default(autoincrement())
  account_id            Int
  webhook_url           String?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
  identifier            String?
  hmac_token            String?
  hmac_mandatory        Boolean  @default(false)
  additional_attributes Json     @default("{}")

  @@unique([hmac_token])
  @@unique([identifier])
}

model channel_email {
  id                        Int      @id @default(autoincrement())
  account_id                Int
  email                     String
  forward_to_email          String
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt
  imap_enabled              Boolean  @default(false)
  imap_address              String   @default("")
  imap_port                 Int      @default(0)
  imap_login                String   @default("")
  imap_password             String   @default("")
  imap_enable_ssl           Boolean  @default(true)
  smtp_enabled              Boolean  @default(false)
  smtp_address              String   @default("")
  smtp_port                 Int      @default(0)
  smtp_login                String   @default("")
  smtp_password             String   @default("")
  smtp_domain               String   @default("")
  smtp_enable_starttls_auto Boolean  @default(true)
  smtp_authentication       String   @default("login")
  smtp_openssl_verify_mode  String   @default("none")
  smtp_enable_ssl_tls       Boolean  @default(false)
  provider_config           Json     @default("{}")
  provider                  String?
  verified_for_sending      Boolean  @default(false)

